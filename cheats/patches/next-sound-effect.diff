+#pragma section CHEAT
+/* Every sound effect is the next one in the list: when a sound code is a sound effect (its sequence
+   header byte is 1-0x7F) and the next code is one too, play the next code instead. Music (header 0),
+   the 0x80-0xFF control sequences and empty codes are left alone. */
+s32 cheat_se_header(u16 code) {
+    u32 ofs;
+    while (code >= snd_seq_max) {
+        code -= snd_seq_max;
+    }
+    ofs = snd_seq_data[code + 1];
+    if (ofs == 0) {
+        return 0;
+    }
+    return *(u8*)((u32)snd_seq_data + ofs);
+}
+
+u16 cheat_next_se(u16 code) {
+    s32 a = cheat_se_header(code);
+    s32 b = cheat_se_header(code + 1);
+    if (a >= 1 && a <= 0x7F && b >= 1 && b <= 0x7F) {
+        return code + 1;
+    }
+    return code;
+}
+
+s32 sound_request(s32 code) {
+    return sound_request_orig(cheat_next_se(code));
+}
+
+void sound_request_pan(u16 code, s16 vol_l, s16 vol_r, s16 time, s16 ramp) {
+    sound_request_pan_orig(cheat_next_se(code), vol_l, vol_r, time, ramp);
+}
+#pragma section
