+
+#pragma section CHEAT
+/* Music and sound effects play 2 whole tones higher: 4 semitones (256 each, 3072 an octave) are added to
+   the voice's pitches while it writes the pitch register, then taken off again. Everything the
+   original does with them is relative, so the notes and slides are unchanged otherwise. */
+void voice_process_secondary(SNDVOICE* voice, u8 voice_index, u8 is_bgm) {
+    voice->current_pitch += 1024;
+    voice->target_pitch += 1024;
+    voice->decoded_pitch += 1024;
+    voice_process_secondary_orig(voice, voice_index, is_bgm);
+    voice->current_pitch -= 1024;
+    voice->target_pitch -= 1024;
+    voice->decoded_pitch -= 1024;
+}
+#pragma section
