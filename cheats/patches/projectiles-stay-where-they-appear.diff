+/* Projectiles stay where they appear: while a shell is in normal flight, its position is put back
+   after its process has moved it. */
+void effect_13_move(WORK_Other* ewk) {
+    s32 x = ewk->wu.xyz[0].cal;
+    s32 y = ewk->wu.xyz[1].cal;
+    s32 run = (ewk->wu.routine_no[0] == R0_MOVE && ewk->wu.routine_no[1] == R1_MOVE);
+    effect_13_move_orig(ewk);
+    if (run && ewk->wu.routine_no[0] == R0_MOVE && ewk->wu.routine_no[1] == R1_MOVE) {
+        ewk->wu.xyz[0].cal = x;
+        ewk->wu.xyz[1].cal = y;
+    }
