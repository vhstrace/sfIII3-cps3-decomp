+#pragma section CHEAT
+/* The CPU opponent walks twice as fast: a CPU fighter (operator 0) walking forward (Normal_03000) or
+   back (Normal_04000) moves by its walk speed a second time each frame. Not in the attract demo. */
+void Normal_03000(PLW* wk) {
+    Normal_03000_orig(wk);
+    if (wk->wu.operator == 0 && Demo_Flag && wk->wu.routine_no[1] == PLAYER_NORMAL && wk->wu.routine_no[2] == 3 && wk->wu.routine_no[3] == N03_MOVE) {
+        add_mvxy_speed(&wk->wu);
+    }
+}
+
+void Normal_04000(PLW* wk) {
