+#pragma section CHEAT
+/* Every attack hits the opponent no matter where they are: during the hit check, a fighter whose attack
+   is active is moved for a moment so that its first attack box is centred on the opponent's first body
+   box. It is put back afterwards (unless the hit check moved it). */
+void hit_check_main_process(void) {
+    PLW* as;
+    PLW* ds;
+    const s16* ab;
+    const s16* db;
+    s16 i;
+    s16 n;
+    s16 ac;
+    s16 dc;
+    s16 ox;
+    s16 oy;
+    s16 nx;
+    s16 ny;
+    as = 0;
+    if (Allow_a_battle_f && Bonus_Game_Flag == 0) {
+        for (i = 0; i < 2; i++) {
+            as = &plw[i];
+            ds = &plw[i ^ 1];
+            if (as->wu.cg_ja.atix == 0 || as->wu.att_hit_ok == 0 || as->wu.h_att == 0 || ds->wu.h_bod == 0) {
+                as = 0;
+                continue;
+            }
+            for (n = 0; n < 4; n++) {
+                if (as->wu.h_att->att_box[n][1] != 0) {
+                    break;
+                }
+            }
+            db = ds->wu.h_bod->body_dm[0];
+            if (n == 4 || db[1] == 0) {
+                as = 0;
+                continue;
+            }
+            ab = as->wu.h_att->att_box[n];
+            if (as->wu.rl_flag) {
+                ac = -ab[0] - ab[1] + ab[1] / 2;
+            } else {
+                ac = ab[0] + ab[1] / 2;
+            }
+            if (ds->wu.rl_flag) {
+                dc = -db[0] - db[1] + db[1] / 2;
+            } else {
+                dc = db[0] + db[1] / 2;
+            }
+            ox = as->wu.xyz[0].disp.pos;
+            oy = as->wu.xyz[1].disp.pos;
+            nx = ds->wu.xyz[0].disp.pos + dc - ac;
+            ny = ds->wu.xyz[1].disp.pos + (db[2] + db[3] / 2) - (ab[2] + ab[3] / 2);
+            as->wu.xyz[0].disp.pos = nx;
+            as->wu.xyz[1].disp.pos = ny;
+            break;
+        }
+    }
+    hit_check_main_process_orig();
+    if (as != 0) {
+        if (as->wu.xyz[0].disp.pos == nx) {
+            as->wu.xyz[0].disp.pos = ox;
+        }
+        if (as->wu.xyz[1].disp.pos == ny) {
+            as->wu.xyz[1].disp.pos = oy;
+        }
+    }
+}
+#pragma section
