+#pragma section CHEAT
+/* Player 2 parries every attack: during the hit check, player 2's parry inputs (forward, down, the two
+   air parries and the anti-air parry) all look freshly entered. They are put back afterwards. */
+void hit_check_main_process(void) {
+    s16* wf;
+    s16 f3, f4, f5, f6, f12;
+    if (plw[1].cp == 0) {               /* before the first fight sets it up */
+        hit_check_main_process_orig();
+        return;
+    }
+    wf = plw[1].cp->waza_flag;
+    f3 = wf[3]; f4 = wf[4]; f5 = wf[5]; f6 = wf[6]; f12 = wf[12];
+    wf[3] = wf[4] = wf[5] = wf[6] = wf[12] = 10;
+    hit_check_main_process_orig();
+    wf[3] = f3;
+    wf[4] = f4;
+    wf[5] = f5;
+    wf[6] = f6;
+    wf[12] = f12;
+}
