+#pragma section CHEAT
+/* Cheat: special moves go 1.5 times as far sideways. A special move's animation row comes from rows 8-17
+   of asstbl_sa_ground or asstbl_sa_air (rows 0-7 are the super arts). Whatever the move's routine
+   moves the fighter sideways this frame, half of it is added again. */
+void Player_attack(PLW* wk) {
+    s32 x0 = wk->wu.xyz[0].cal;
+    s32 sp = 0;
+    const AS* as = wk->as;
+    s16 pn = wk->player_number;
+    if (wk->wu.routine_no[2] >= ATTACK_SPECIAL && Bonus_Game_Flag == 0 &&
+        ((as >= &asstbl_sa_ground[pn][8][0].as && as <= &asstbl_sa_ground[pn][17][3].as) ||
+         (as >= &asstbl_sa_air[pn][8][0].as && as <= &asstbl_sa_air[pn][17][3].as))) {
+        sp = 1;
+    }
+    Player_attack_orig(wk);
+    if (sp && wk->tsukami_f == 0 && wk->tsukamare_f == 0) {
+        wk->wu.xyz[0].cal += (wk->wu.xyz[0].cal - x0) / 2;
+    }
+}
+#pragma section
