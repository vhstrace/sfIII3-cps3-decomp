+#pragma section CHEAT
+/* Slippery floors: a standing fighter keeps the sideways speed of the walk, dash, jump or move before,
+   and slows down by 1/16 of it each frame. */
+void Normal_01000(PLW* wk) {
+    s32 sp;
+    Normal_01000_orig(wk);
+    if (wk->wu.xyz[1].disp.pos != 0) {
+        return;
+    }
+    sp = wk->wu.mvxy.a[0].sp;
+    if (wk->wu.rl_flag) {
+        wk->wu.xyz[0].cal += sp;
+    } else {
+        wk->wu.xyz[0].cal -= sp;
+    }
+    sp -= sp >> 4;
+    if (sp < 0x1000 && sp > -0x1000) {
+        sp = 0;
+    }
+    wk->wu.mvxy.a[0].sp = sp;
+}
+#pragma section
