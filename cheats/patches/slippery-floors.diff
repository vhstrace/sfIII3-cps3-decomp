+#pragma section CHEAT
+/* Slippery floors: on the ground, a fighter's sideways speed only eases toward the speed the game
+   moves them at, by 1/16 of the difference a frame, so a fighter speeds up slowly into a walk or
+   dash and slides on after it, a landing or a hit. The speed is kept in pt_free[8-9], in 1/256
+   pixels a frame.
+   Also, about 1 time in 10 that a fighter lands from a jump (or a normal jump attack) or comes out of a
+   dash during a fight, their feet slip: they get a sweep's knockdown (damage reaction 89) and lose
+   6 vitality, without a KO. The roll uses each fighter's own random number in pt_free[10-11]
+   (a 16-bit LCG stepped with the system timer added), not the CPU's random table. */
+void player_mv_4000(PLW* wk) {
+    s16* v = (s16*)&wk->pt_free[8];
+    u16* rs = (u16*)&wk->pt_free[10];
+    s32 x0 = wk->wu.xyz[0].cal;
+    s16 y0 = wk->wu.xyz[1].disp.pos;
+    s16 r1 = wk->wu.routine_no[1];
+    s16 r2 = wk->wu.routine_no[2];
+    s16 n1;
+    s32 dx;
+    s32 d;
+    player_mv_4000_orig(wk);
+    if (Bonus_Game_Flag || wk->tsukami_f || wk->tsukamare_f) {
+        *v = 0;
+        return;
+    }
+    n1 = wk->wu.routine_no[1];
+    if (wk->wu.xyz[1].disp.pos <= 0 && (n1 == PLAYER_NORMAL || n1 == PLAYER_ATTACK)
+        && ((y0 > 0 && (r1 == PLAYER_NORMAL || (r1 == PLAYER_ATTACK && r2 < ATTACK_SPECIAL)))
+            || (r1 == PLAYER_NORMAL && n1 == PLAYER_NORMAL && (r2 == 5 || r2 == 6)
+                && wk->wu.routine_no[2] != r2))
+        && Allow_a_battle_f && wk->dead_flag == 0 && ((PLW*)wk->wu.target_adrs)->dead_flag == 0
+        && wk->atemi_flag == 0 && wk->wu.hit_stop == 0 && wk->wu.dm_stop == 0
+        && (*rs = (u16)(*rs * 25173 + 13849 + system_timer), (*rs >> 8) % 10 == 0)) {
+        wk->wu.routine_no[1] = PLAYER_DAMAGE;
+        wk->wu.routine_no[2] = 89;
+        wk->wu.routine_no[3] = RN3_START;
+        wk->wu.dmg_adrs = wk->wu.target_adrs;
+        wk->wu.dm_vital = 0;
+        wk->wu.dm_piyo = 0;
+        wk->wu.dm_arts_point = 0;
+        wk->wu.dm_koa = 0;
+        wk->wu.dm_attlv = 2;
+        wk->wu.dm_butt_type = 1;
+        wk->wu.dm_plnum = wk->player_number;
+        wk->wu.dm_zuru = 7;
+        wk->wu.dm_rl = (wk->wu.rl_flag + 1) & 1;
+        wk->wu.dm_quake = wk->wu.hit_quake = 0;
+        wk->wu.vital_new -= 6;
+        if (wk->wu.vital_new < 0) {
+            wk->wu.vital_new = 0;
+        }
+    }
+    if (wk->wu.hit_stop || wk->wu.dm_stop) {
+        return;
+    }
+    dx = (wk->wu.xyz[0].cal - x0) >> 8;
+    if (dx > 0x2000 || dx < -0x2000) {
+        *v = 0;
+        return;
+    }
+    if (wk->wu.xyz[1].disp.pos > 0) {
+        *v = dx;
+        return;
+    }
+    d = dx - *v;
+    if (d > -16 && d < 16) {
+        *v = dx;
+    } else {
+        *v += d / 16;
+    }
+    wk->wu.xyz[0].cal = x0 + ((s32)*v << 8);
+}
+#pragma section
