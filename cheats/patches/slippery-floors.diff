+#pragma section CHEAT
+/* Slippery floors: on the ground, a fighter's sideways speed only eases toward the speed the game
+   moves them at. It catches up by 1/4 of the difference a frame when speeding up, and by 1/16 when
+   slowing down or turning, so a fighter slides on after a walk, dash, landing or hit. The speed is
+   kept in pt_free[8-9], in 1/256 pixels a frame. */
+void player_mv_4000(PLW* wk) {
+    s16* v = (s16*)&wk->pt_free[8];
+    s32 x0 = wk->wu.xyz[0].cal;
+    s32 dx;
+    s32 d;
+    player_mv_4000_orig(wk);
+    if (Bonus_Game_Flag || wk->tsukami_f || wk->tsukamare_f) {
+        *v = 0;
+        return;
+    }
+    if (wk->wu.hit_stop || wk->wu.dm_stop) {
+        return;
+    }
+    dx = (wk->wu.xyz[0].cal - x0) >> 8;
+    if (dx > 0x2000 || dx < -0x2000) {
+        *v = 0;
+        return;
+    }
+    if (wk->wu.xyz[1].disp.pos > 0) {
+        *v = dx;
+        return;
+    }
+    d = dx - *v;
+    if (d > -16 && d < 16) {
+        *v = dx;
+    } else if ((*v >= 0 && d > 0 && dx > 0) || (*v <= 0 && d < 0 && dx < 0)) {
+        *v += d / 4;
+    } else {
+        *v += d / 16;
+    }
+    wk->wu.xyz[0].cal = x0 + ((s32)*v << 8);
+}
+#pragma section
