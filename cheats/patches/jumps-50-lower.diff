+#pragma section CHEAT
+/* Cheat: jumps are 50% lower. When a jump takes off, its upward speed and its gravity
+   (mvxy.a[1] and mvxy.d[1], 16.16) are cut in half, so the arc is half as high but lasts as long
+   and goes as far sideways. The takeoff frame already moved the fighter up by the full speed, so
+   half of that is taken back. Jump attacks go on with the same speeds. */
+void cheat_lower_jump(PLW* wk) {
+    s32 sp = wk->wu.mvxy.a[1].sp;
+    wk->wu.xyz[1].cal -= sp / 2;
+    wk->wu.mvxy.a[1].sp = sp - sp / 2;
+    wk->wu.mvxy.d[1].sp -= wk->wu.mvxy.d[1].sp / 2;
+}
+
+void Normal_18000(PLW* wk) {
+    s16 r3 = wk->wu.routine_no[3];
+    Normal_18000_orig(wk);
+    if (r3 == RN3_START) {
+        cheat_lower_jump(wk);
+    }
+}
+
+void Normal_18000_init_unit(PLW* wk, u8 ps) {
+    Normal_18000_init_unit_orig(wk, ps);
+    cheat_lower_jump(wk);
+}
+
+void Normal_53000(PLW* wk) {
+    s16 r2 = wk->wu.routine_no[2];
+    Normal_53000_orig(wk);
+    if (wk->wu.routine_no[2] != r2) {
+        cheat_lower_jump(wk);
+    }
+}
+#pragma section
