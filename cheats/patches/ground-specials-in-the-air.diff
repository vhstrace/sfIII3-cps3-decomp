@@ -1582,7 +1582,7 @@ void nm_95000(PLW* wk) {}
 
 
 
-void process_attack(PLW* wk) {
+void process_attack_orig(PLW* wk) {   /* was process_attack: unchanged */
     if (wk->wu.routine_no[3]) {
         if (check_ashimoto_ex(wk)) {
             return;
@@ -1675,3 +1675,21 @@ s32 check_cg_cancel_data(PLW* wk) {
     }
     return 0;
 }
+
+
+#pragma section CHEAT
+/* Cheat: ground special moves in the air. A move only ends on the ground (process_attack checks
+   cue 255 and 64 only at height 0), so once the animation reaches its end cue in the air, fall 8
+   pixels a frame until landing. */
+void process_attack(PLW* wk) {
+    process_attack_orig(wk);
+    if (wk->wu.routine_no[1] == PLAYER_ATTACK && wk->wu.routine_no[3] != RN3_START
+        && (wk->wu.cg_type == 0xFF || wk->wu.cg_type == 64) && wk->wu.xyz[1].disp.pos > 0
+        && !(Bonus_Game_Flag == BONUS_CAR && wk->bs2_on_car)) {
+        wk->wu.xyz[1].disp.pos -= 8;
+        if (wk->wu.xyz[1].disp.pos < 0) {
+            wk->wu.xyz[1].disp.pos = 0;
+        }
+    }
+}
+#pragma section
