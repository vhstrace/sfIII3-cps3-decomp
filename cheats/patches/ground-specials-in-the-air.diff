 /* Start the special move whose command has been entered, on the ground or in the air (its EX version
  * when allowed); 1 when one starts. */
-s32 check_special_attack(PLW* wk) {
+s32 check_special_attack_orig(PLW* wk) {   /* was check_special_attack: unchanged */
     s16 i;
     s16 j;
     u16 cusw;
@@ -641,3 +641,29 @@ s32 check_leap_attack(PLW* wk) {
 }
 
 
+#pragma section CHEAT
+/* Cheat: ground special moves in the air. If no air special matches, check the ground specials with
+   the height set to 0, then put the height back. pt_free[4] tells Player_attack to keep the height
+   when the move's first step forces a landing (hoken_muriyari_chakuchi). */
+s32 check_special_attack(PLW* wk) {
+    s16 y;
+    if ((Bonus_Game_Flag == BONUS_CAR && wk->bs2_on_car) || wk->wu.xyz[1].disp.pos <= 0) {
+        return check_special_attack_orig(wk);
+    }
+    if (check_special_attack_orig(wk)) {
+        return 1;
+    }
+    if (pcon_dp_flag || (wk->spmv_ng_flag & 0x20000000)) {
+        return 0;
+    }
+    y = wk->wu.xyz[1].disp.pos;
+    wk->wu.xyz[1].disp.pos = 0;
+    if (check_special_attack_orig(wk)) {
+        wk->wu.xyz[1].disp.pos = y;
+        wk->pt_free[4] = 1;
+        return 1;
+    }
+    wk->wu.xyz[1].disp.pos = y;
+    return 0;
+}
+#pragma section
