--- a/src/PLPAT.c
+++ b/src/PLPAT.c
@@ -194,7 +194,7 @@ const u8* cjdr_defense_table[24] = {
 };
 
 
-void Player_attack(PLW* wk) {
+void Player_attack_orig(PLW* wk) {   /* was Player_attack: unchanged */
     wk->wu.next_z = wk->wu.my_priority;
     wk->running_f = 0;
     wk->py->flag = 0;
@@ -809,3 +809,22 @@ void hoken_muriyari_chakuchi(PLW* wk) {
         wk->wu.xyz[1].disp.pos = 0;
     }
 }
+
+
+#pragma section CHEAT
+/* Cheat: ground special moves in the air. Keep the height through the move's first step, which
+   forces a landing (hoken_muriyari_chakuchi). */
+void Player_attack(PLW* wk) {
+    s16 y;
+    if (wk->pt_free[4]) {
+        wk->pt_free[4] = 0;
+        y = wk->wu.xyz[1].disp.pos;
+        Player_attack_orig(wk);
+        if (wk->wu.routine_no[1] == PLAYER_ATTACK) {
+            wk->wu.xyz[1].disp.pos = y;
+        }
+        return;
+    }
+    Player_attack_orig(wk);
+}
+#pragma section
diff --git a/src/PLS00.c b/src/PLS00.c
index bf104b3..b23cb85 100644
--- a/src/PLS00.c
