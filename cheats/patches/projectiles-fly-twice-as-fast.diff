+#pragma section CHEAT
+/* Projectiles fly twice as fast: a shell in normal flight moves by its speed a second time each frame.
+   Only the kinds of shell whose flight step is add_mvxy_speed (kotp 0, 3, 5-9, 12, 15, 16). */
+void effect_13_move(WORK_Other* ewk) {
+    TAMA* tama = (TAMA*)ewk->wu.my_effadrs;
+    s32 run = (ewk->wu.routine_no[0] == R0_MOVE && EXE_flag == 0 && Game_pause == 0);
+    effect_13_move_orig(ewk);
+    if (run && ewk->wu.routine_no[0] == R0_MOVE && ewk->wu.routine_no[1] == R1_MOVE &&
+        ewk->wu.hit_stop == 0 && ((0x193E9 >> tama->kind_of_tama) & 1)) {
+        add_mvxy_speed(&ewk->wu);
+    }
