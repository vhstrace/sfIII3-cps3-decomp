+#pragma section CHEAT
+/* The floor is a conveyor belt: during a fight, a fighter on the ground is moved 4 pixels to the right
+   every frame, before their own move. The usual screen-edge check runs after this. */
+void Player_move(PLW* wk, u16 lv_data) {
+    if (Allow_a_battle_f && Bonus_Game_Flag == 0 && wk->wu.xyz[1].disp.pos == 0 &&
