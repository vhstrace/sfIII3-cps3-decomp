+
+
+#pragma section CHEAT
+/* Fighters use colours from past the end of the colour table: each fighter's 7 colours sit at a fixed
+   step in the colour ROM (colour 1 minus colour 0). Load each palette part from 7 steps further on
+   (past colour 6), into the fighter's own colour RAM. Parts that every colour shares (step 0) are unchanged. */
+void load_player_color(a, b, c)
+u16 a;
+s16 b;
+s16 c;
+{
+    const XFER* p = player_color_tbl[a][b][c];
+    const XFER* p0 = player_color_tbl[a][b][0];
+    const XFER* p1 = player_color_tbl[a][b][1];
+    s8 i;
+    if (c < 0 || c > 6) {
+        load_player_color_orig(a, b, c);
+        return;
+    }
+    for (i = 0; i < 14; p++, p0++, p1++, i++) {
+        if (p->size) {
+            col_trans_result = col_dma_request(p->src + (p1->src - p0->src) * 7, p->dst, p->size, 0, 0, 0);
+        }
+    }
+}
+#pragma section
