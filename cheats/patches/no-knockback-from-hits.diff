+#pragma section CHEAT
+/* No knockback from hits: a fighter who is hit or blocks on the ground doesn't slide away. Their
+   sideways position is put back after each frame of the hit or block reaction, while they stay on the
+   ground. */
+void Player_damage(PLW* wk) {
+    s32 x = wk->wu.xyz[0].cal;
+    s32 ground = (wk->wu.xyz[1].disp.pos == 0);
+    Player_damage_orig(wk);
+    if (ground && wk->wu.routine_no[1] == PLAYER_DAMAGE && wk->wu.xyz[1].disp.pos == 0) {
+        wk->wu.xyz[0].cal = x;
+    }
+}
