 /* provisional name */
-void sound_request_pan(u16 code, s16 vol_l, s16 vol_r, s16 time, s16 ramp) {
+void sound_request_pan_orig(u16 code, s16 vol_l, s16 vol_r, s16 time, s16 ramp) {   /* was sound_request_pan: unchanged */
     if (vol_l < 0) {
         vol_l = 0;
     } else if (vol_l > 127) {
@@ -536,3 +536,41 @@ void sound_driver_tick(void) {
         }
     }
 }
+
+
+#pragma section CHEAT
+/* Combo hits fall in pitch: a sound effect voice that starts a new sound loses the combo pitch
+   mark (reserved_71[0]) of its last sound. Se_Shock sets it again for hit sounds. Every sound
+   from other files starts through sound_request or sound_request_pan. */
+void cheat_clear_pitch_marks(u8** cur) {
+    s32 i;
+    for (i = 0; i < 16; i++) {
+        if (se_voice[i].cursor != cur[i]) {
+            se_voice[i].reserved_71[0] = 0;
+        }
+    }
+}
+
+void cheat_save_cursors(u8** cur) {
+    s32 i;
+    for (i = 0; i < 16; i++) {
+        cur[i] = se_voice[i].cursor;
+    }
+}
+
+s32 sound_request(s32 code) {
+    u8* cur[16];
+    s32 r;
+    cheat_save_cursors(cur);
+    r = sound_request_orig(code);
+    cheat_clear_pitch_marks(cur);
+    return r;
+}
+
+void sound_request_pan(u16 code, s16 vol_l, s16 vol_r, s16 time, s16 ramp) {
+    u8* cur[16];
+    cheat_save_cursors(cur);
+    sound_request_pan_orig(code, vol_l, vol_r, time, ramp);
+    cheat_clear_pitch_marks(cur);
+}
+#pragma section
