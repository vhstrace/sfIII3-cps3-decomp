@@ -101,7 +101,7 @@ void Se_Dummy(WORK_Other* ewk, u16 Code) {
 
 
 
-void Se_Shock(WORK_Other* ewk, u16 Code) {
+void Se_Shock_orig(WORK_Other* ewk, u16 Code) {   /* was Se_Shock: unchanged */
     u16 se;
     s16 pos;
     PLW* em;
@@ -348,3 +348,43 @@ s16 Code;
     }
     return Bonus_SE_Voice_Data[Code - 0x100];
 }
+
+
+#pragma section CHEAT
+/* Combo hits fall in pitch: the hit sound of a combo's Nth hit plays N-1 steps down a major scale
+   (2 octaves at most). The steps, in semitones, go in the voice's spare byte reserved_71[0], which
+   the voice_process_secondary hook adds to its pitch; the sound_seq_start hook clears it when a
+   voice starts any other sound. */
+const u8 cheat_combo_scale[15] = { 0, 1, 3, 5, 7, 8, 10, 12, 13, 15, 17, 19, 20, 22, 24 };
+
+void Se_Shock(WORK_Other* ewk, u16 Code) {
+    u8* cur[16];
+    PLW* em;
+    s32 n;
+    s32 i;
+    for (i = 0; i < 16; i++) {
+        cur[i] = se_voice[i].cursor;
+    }
+    Se_Shock_orig(ewk, Code);
+    if (ewk->wu.work_id == 1) {
+        em = (PLW*)ewk->wu.target_adrs;
+    } else {
+        em = (PLW*)((PLW*)ewk->my_master)->wu.target_adrs;
+    }
+    n = 0;
+    if (em->wu.work_id == 1) {
+        n = em->cb->total - 1;
+    }
+    if (n < 0) {
+        n = 0;
+    }
+    if (n > 14) {
+        n = 14;
+    }
+    for (i = 0; i < 16; i++) {
+        if (se_voice[i].cursor != cur[i]) {
+            se_voice[i].reserved_71[0] = cheat_combo_scale[n];
+        }
+    }
+}
+#pragma section
diff --git a/src/sound_voice_2.c b/src/sound_voice_2.c
index c442f43..9df945f 100644
--- a/src/sound_voice_2.c
+++ b/src/sound_voice_2.c
@@ -123,7 +123,7 @@ u16 sound_voice_volume_compute(u16 level, u32 pan_scale, s8 vol_offset, SNDVOICE
     } while (0)
 
 /* provisional name */
-void voice_process_secondary(SNDVOICE* voice, u8 voice_index, u8 is_bgm) {
+void voice_process_secondary_orig(SNDVOICE* voice, u8 voice_index, u8 is_bgm) {   /* was voice_process_secondary: unchanged */
     u8 owns_hardware_voice = 1;
     SNDREGS* regs;
     s32 next;
@@ -450,3 +450,23 @@ void sound_reg_write_verify(s16 *reg, u16 value) {
         }
     }
 }
+
+
+#pragma section CHEAT
+/* Combo hits fall in pitch: a sound effect voice plays reserved_71[0] semitones (256 each) lower.
+   The pitches are lowered while the original writes the pitch register, then put back, as in "Music
+   and sound effects high-pitched". */
+void voice_process_secondary(SNDVOICE* voice, u8 voice_index, u8 is_bgm) {
+    s32 d = 0;
+    if (!is_bgm) {
+        d = -(voice->reserved_71[0] << 8);
+    }
+    voice->current_pitch += d;
+    voice->target_pitch += d;
+    voice->decoded_pitch += d;
+    voice_process_secondary_orig(voice, voice_index, is_bgm);
+    voice->current_pitch -= d;
+    voice->target_pitch -= d;
+    voice->decoded_pitch -= d;
+}
+#pragma section
