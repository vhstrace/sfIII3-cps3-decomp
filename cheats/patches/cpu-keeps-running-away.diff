+
+#pragma section CHEAT
+/* The CPU opponent keeps running away: in a paid game (not the attract demo or bonus stages), while
+   the fight allows input, the CPU always holds the lever away from its opponent. */
+s32 CPU_Sub(PLW* wk) {
+    WORK* em = (WORK*)wk->wu.target_adrs;
+    if (Demo_Flag && Bonus_Game_Flag == 0 && Allow_a_battle_f && pcon_dp_flag != 1) {
+        if (wk->wu.xyz[0].disp.pos < em->xyz[0].disp.pos) {
+            return LEVER_LEFT;
+        }
+        return LEVER_RIGHT;
+    }
+    return CPU_Sub_orig(wk);
+}
