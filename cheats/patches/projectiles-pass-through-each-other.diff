+#pragma section CHEAT
+/* Projectiles pass through each other: when one projectile (effect 13) hits another, nothing happens,
+   and the attacking one may still hit something else. */
+void effect_at_vs_effect_dm(s16 ix2, s16 ix) {
+    WORK_Other* as = (WORK_Other*)q_hit_push[ix2];
+    WORK_Other* ds = (WORK_Other*)q_hit_push[ix];
+    if (as->wu.id == 13 && ds->wu.id == 13) {
+        as->wu.att_hit_ok = 1;
+        return;
+    }
+    effect_at_vs_effect_dm_orig(ix2, ix);
+}
