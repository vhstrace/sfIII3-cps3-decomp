+#pragma section CHEAT
+/* The Super Art gauge is always full: refill both gauges every frame, except while an art is running. */
+void Player_control(void) {
+    s16 i;
+    SA_WORK* sa;
+    if (Bonus_Game_Flag == 0) {
+        for (i = 0; i < 2; i++) {
+            sa = &super_arts[i];
+            if (sa->ok != -1 && sa->store_max > 0) {
+                sa->store = sa->store_max;
+                if (sa->gauge_type == SA_GAUGE_TIMER) {
+                    sa->gauge.s.h = sa->gauge_len;
+                } else {
+                    sa->gauge.i = 0;
+                }
+            }
+        }
+    }
+    Player_control_orig();
+}
