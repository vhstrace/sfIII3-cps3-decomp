+#pragma section CHEAT
+s32 debug_scene_outer_dispatch(void);
+
+/* The debug menu: in the attract mode, hold P1 Start + LP + LK to run the debug menu left in CMD_MAIN.c
+   (debug_scene_outer_dispatch). Its own exit, P2 LP + MP + HP + LK, goes back to the attract mode.
+   Debug_w (never used by the game) holds 0x5A while the menu runs. */
+void Loop_Demo(void) {
+    if (Debug_w[0] == 0x5A) {
+        if (debug_scene_outer_dispatch()) {
+            Debug_w[0] = 0;
+            G_No0 = G0_DEMO;
+            G_No1 = G1_DEMO_INIT;
+            G_No2 = 0;
+            G_No3 = 0;
+        }
+        return;
+    }
+    if ((p1sw_0 & (BUTTON_START | BUTTON_LP | BUTTON_LK)) == (BUTTON_START | BUTTON_LP | BUTTON_LK)) {
+        Debug_w[0] = 0x5A;
+        Debug_R_No = Debug_Select_No = Debug_Menu_No = 0;
+        return;
+    }
+    Loop_Demo_orig();
+}
+#pragma section
